---
import '../styles/unloop.css';
interface Props { title?: string; description?: string; privacy?: boolean; showDownload?: boolean; }
const {
  title = 'Unloop · Block distracting apps and stay focused.',
  description = 'Block distracting apps and stay focused.',
  privacy = false,
  showDownload = !privacy,
} = Astro.props;
const base = Astro.url.pathname.startsWith('/unloop') ? '/unloop' : '';
const siteUrl = Astro.site ? Astro.site.origin : 'https://unloop.nsaicharan.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const bannerUrl = `${siteUrl}/banner.png`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try { const mode = localStorage.getItem('unloop-theme'); if (mode === 'light' || mode === 'dark') document.documentElement.dataset.theme = mode; } catch {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7fbf2" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/media/logo.svg" />
    <link rel="alternate icon" href="/media/icon.png" />

    <!-- Open Graph / Social Sharing Thumbnail -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={bannerUrl} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="500" />
    <meta property="og:image:alt" content="Unloop - Block distracting apps and stay focused." />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={bannerUrl} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    {showDownload && (
      <section class="download-section shell" aria-labelledby="download-title">
        <img src="/media/logo.svg" width="64" height="64" alt="" />
        <h2 id="download-title">Start focusing with Unloop</h2>
        <a class="download" href="https://play.google.com/store/apps/details?id=com.charan.unloop" target="_blank" rel="noopener noreferrer"><img class="play-store-logo" src="/play_store.svg" width="20" height="22" alt="" />Get it on Google Play</a>
      </section>
    )}
    <footer class="site-footer">
      <div class="site-footer-content shell">
        <nav class="footer-links" aria-label="Footer">
          <a href="https://github.com/sai0x20charan/unloop" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={`${base}/testing`}>Join testing</a>
          <a href={`${base}/privacy-policy`} target="_blank" rel="noopener noreferrer">Privacy policy</a>
        </nav>
        <p>Designed & built by <a href="https://nsaicharan.com" target="_blank" rel="noopener noreferrer">Sai Charan</a></p>
      </div>
    </footer>
  </body>
</html>
